# ═══════════════════════════════════════════════════════════════
# CARDIQUE HELPDESK — Variables de entorno
# Copia este archivo a .env y completa los valores marcados con <>
# ═══════════════════════════════════════════════════════════════

APP_NAME="CARDIQUE Helpdesk"
APP_ENV=production
APP_KEY=                              # Genera con: php artisan key:generate
APP_DEBUG=false
APP_URL=https://api.tudominio.gov.co
FRONTEND_URL=https://helpdesk.tudominio.gov.co

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# ─── Base de datos ───────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=postgresql                    # Nombre del servicio Docker (o Railway host)
DB_PORT=5432
DB_DATABASE=helpdesk
DB_USERNAME=helpdesk
DB_PASSWORD=<cambia_esta_contraseña>

# ─── Sesión ──────────────────────────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=60
SESSION_DOMAIN=.tudominio.gov.co

# ─── Sanctum / Autenticación ─────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=helpdesk.tudominio.gov.co
SANCTUM_TOKEN_EXPIRATION=60          # Minutos. El refresh token dura 7 días.

# ─── Broadcasting (WebSockets) ────────────────────────────────
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=<genera_id_unico>
REVERB_APP_KEY=<genera_clave_unica>
REVERB_APP_SECRET=<genera_secreto_unico>
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SCHEME=https

# ─── Cola de trabajos ────────────────────────────────────────
QUEUE_CONNECTION=redis

# ─── Caché ──────────────────────────────────────────────────
CACHE_STORE=redis
CACHE_PREFIX=helpdesk_

# ─── Redis ──────────────────────────────────────────────────
REDIS_CLIENT=predis
REDIS_HOST=redis                      # Nombre del servicio Docker
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Almacenamiento de archivos (Cloudflare R2, S3-compatible) ──
FILESYSTEM_DISK=s3

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=helpdesk
AWS_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_URL=                              # dominio público (r2.dev o custom domain) para servir attachments

# ─── Respaldos automáticos (DB + manifiesto de adjuntos) ───────
BACKUP_RETENTION_DAYS=30

# ─── Correo electrónico ──────────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=soporte@tudominio.gov.co
MAIL_PASSWORD=<contraseña_o_app_password>
MAIL_FROM_ADDRESS=soporte@tudominio.gov.co
MAIL_FROM_NAME="${APP_NAME}"

# ─── Google OAuth (Gmail + Calendar) ─────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=${APP_URL}/api/gmail/oauth/callback

# ─── WhatsApp Business API ───────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=<cadena_secreta_para_verificar_webhook>

# ─── IA / LLM ───────────────────────────────────────────────
AI_API_KEY=
AI_API_URL=

# ─── Documentación API (Scramble) ───────────────────────────
# La documentación estará disponible en /docs
# Solo accesible por usuarios con permiso: settings.update
